# Apex CLI — Extended Vulnerability Patterns
# Beyond OWASP Top 10: the patterns that COMBINE into real exploits.
#
# Format: PATTERN_ID|SEVERITY|CHAIN_WITH|DESCRIPTION|GREP_PATTERN|FILE_GLOB
#
# CHAIN_WITH: other patterns that together form a critical vuln
# A single "warning" becomes "critical" when chained with another finding.
#
# ═══ INJECTION VARIANTS (beyond basic SQLi/XSS) ═══
NOSQL-INJECT|error|AUTH-BYPASS|NoSQL operator injection ($ne, $gt, $regex)|(\$ne|\$gt|\$lt|\$regex|\$where|\$exists).*req\.(body|query|params)|*.{js,ts}
LDAP-INJECT|error|AUTH-BYPASS|LDAP injection via string concat|ldap.*(search|bind).*\+.*(req|input|user)|*.{js,ts,py,java}
XPATH-INJECT|error|DATA-LEAK|XPath injection in XML queries|xpath.*(query|evaluate).*\+.*(req|input|param)|*.{js,ts,py,java}
CRLF-INJECT|error|HEADER-INJECT|CRLF injection in HTTP headers|setHeader.*\+.*(req|input|param)|*.{js,ts,py}
TEMPLATE-INJECT|critical|RCE|Server-side template injection|render.*(req\.|input|user)|*.{js,ts,py,rb}
GRAPHQL-INJECT|error|DATA-LEAK|GraphQL introspection + injection|introspection.*true|buildSchema.*\+|*.{js,ts,py}
EXPRESSION-LANG|critical|RCE|Expression language injection (SpEL, OGNL, EL)|SpelExpression|OgnlUtil|ELProcessor.*\+|*.java
#
# ═══ AUTHENTICATION WEAKNESSES ═══
TIMING-ATTACK|error|AUTH-BYPASS|Non-constant-time comparison for secrets|(password|token|secret|key|hash).*[!=]=[^=]|*.{js,ts,py,rb,php,java,go}
JWT-NONE|critical|AUTH-BYPASS|JWT algorithm confusion / none attack|algorithm.*none|verify.*false|decode.*verify.*false|*.{js,ts,py,rb}
JWT-KID-INJECT|critical|RCE|JWT kid header injection (path traversal/SQLi)|kid.*sql|kid.*path|kid.*file|*.{js,ts,py}
WEAK-RANDOM|error|TOKEN-PREDICT|Predictable random for security tokens|Math\.random|random\.random|rand\(\)|srand\(time|*.{js,ts,py,rb,php,c,cpp}
SESSION-FIXATION|error|AUTH-BYPASS|Session not regenerated after login|login.*session(?!.*regenerate|.*destroy)|*.{js,ts,py,rb,php}
HARDCODED-SECRET|error|AUTH-BYPASS|Hardcoded credentials/API keys|(password|secret|api_key|token)\s*=\s*["'][^"']{8,}|*.{js,ts,py,rb,php,java,go}
OAUTH-OPEN-REDIRECT|error|TOKEN-THEFT|OAuth redirect_uri not validated|redirect_uri.*req\.(query|params)|*.{js,ts,py,rb}
#
# ═══ ACCESS CONTROL ═══
IDOR-PATTERN|error|DATA-LEAK|Direct object reference without ownership check|findById.*req\.params(?!.*owner|.*user.*check|.*auth)|*.{js,ts,py,rb}
MASS-ASSIGN|error|PRIV-ESCALATION|Mass assignment / over-posting|Object\.assign.*req\.body|update\(.*req\.body|\.create\(req\.body|*.{js,ts}
PRIV-ESCALATION|critical|ADMIN-ACCESS|Role check missing or bypassable|isAdmin.*req\.(body|query)|role.*req\.(body|query)|*.{js,ts,py,rb,php}
CORS-REFLECT|error|DATA-THEFT|CORS origin reflection without validation|Access-Control.*Origin.*req\.headers\.origin|*.{js,ts,py}
MISSING-AUTH-CHECK|error|UNAUTH-ACCESS|Route without authentication middleware|router\.(get|post|put|delete).*(?!auth|protect|guard)|*.{js,ts}
#
# ═══ CRYPTOGRAPHIC FAILURES ═══
WEAK-HASH|error|CREDENTIAL-CRACK|Weak hashing (MD5/SHA1 for passwords)|md5\(|sha1\(|createHash.*md5|createHash.*sha1|*.{js,ts,py,rb,php,java}
ECB-MODE|error|CRYPTO-BREAK|ECB mode encryption (pattern leakage)|ECB|aes-128-ecb|AES/ECB|*.{js,ts,py,java,go}
STATIC-IV|error|CRYPTO-BREAK|Static/hardcoded IV for encryption|iv\s*=\s*["']|IV\s*=\s*["']|nonce\s*=\s*["']|*.{js,ts,py,java,go}
NO-CERT-VERIFY|error|MITM|TLS certificate verification disabled|verify.*false|VERIFY_NONE|InsecureSkipVerify.*true|rejectUnauthorized.*false|*.{js,ts,py,go,java}
WEAK-KEY-SIZE|warning|CRYPTO-BREAK|Insufficient key size (<2048 RSA, <256 AES)|generateKeyPair.*1024|keySize.*1024|bits.*1024|*.{js,ts,py,java,go}
#
# ═══ SSRF VARIANTS ═══
SSRF-BASIC|error|CLOUD-TAKEOVER|User URL in server-side request|(fetch|request|axios|urllib|http\.get).*req\.(body|query|params)|*.{js,ts,py,rb,php}
SSRF-DNS-REBIND|critical|INTERNAL-ACCESS|DNS rebinding (check then fetch)|dns.*lookup.*then.*fetch|resolve.*then.*request|*.{js,ts,py}
SSRF-REDIRECT|error|FILTER-BYPASS|Following redirects to internal IPs|followRedirects.*true|maxRedirects|*.{js,ts,py}
PDF-SSRF|error|INTERNAL-ACCESS|HTML-to-PDF with user content (SSRF via iframe/img)|pdf.*html|wkhtmltopdf|puppeteer.*pdf|*.{js,ts,py,rb}
#
# ═══ DESERIALIZATION ═══
PICKLE-RCE|critical|RCE|Python pickle with untrusted data|pickle\.(loads|load)\(|*.py
YAML-RCE|critical|RCE|Unsafe YAML load|yaml\.load\((?!.*Loader.*safe)|yaml\.unsafe_load|*.py
JAVA-DESER|critical|RCE|Java ObjectInputStream without filter|ObjectInputStream(?!.*setObjectInputFilter)|readObject\(\)|*.java
PHP-UNSERIALIZE|critical|RCE|PHP unserialize with user data|unserialize\(.*\$(GET|POST|REQUEST|_COOKIE)|*.php
JACKSON-POLY|critical|RCE|Jackson polymorphic deserialization|enableDefaultTyping|@JsonTypeInfo.*CLASS|*.java
DOTNET-DESER|critical|RCE|.NET BinaryFormatter/unsafe deserializer|BinaryFormatter|ObjectStateFormatter|LosFormatter|*.cs
#
# ═══ FILE OPERATIONS ═══
PATH-TRAVERSAL|error|DATA-LEAK|User input in file path without sanitization|(readFile|open|fopen|include).*req\.(params|query|body)|*.{js,ts,py,rb,php}
ZIP-SLIP|critical|RCE|Archive extraction without path validation|extract.*(?!.*sanitize|.*normalize|.*resolve)|*.{js,ts,py,java,go}
FILE-UPLOAD-RCE|critical|RCE|File upload without extension/content validation|upload.*(?!.*mimetype|.*extension|.*whitelist)|*.{js,ts,py,rb,php}
SYMLINK-RACE|error|PRIV-ESCALATION|Symlink following in privileged operations|readlink|lstat.*then.*open|*.{c,cpp,py,go}
#
# ═══ RACE CONDITIONS ═══
TOCTOU|error|PRIV-ESCALATION|Time-of-check-time-of-use|(access|stat|exists).*\n.*(open|read|write|unlink)|*.{c,cpp,py,go}
DOUBLE-SPEND|critical|FINANCIAL|Non-atomic balance check + debit|balance.*if.*balance.*>.*then.*subtract|*.{js,ts,py,java,go}
RACE-SIGNUP|error|ABUSE|Non-atomic unique constraint check|findOne.*email.*then.*create|*.{js,ts,py}
#
# ═══ BUSINESS LOGIC ═══
NEGATIVE-AMOUNT|error|FINANCIAL|No validation for negative values in transactions|amount.*(?!.*>.*0|.*positive|.*abs)|*.{js,ts,py,java}
RATE-LIMIT-BYPASS|error|ABUSE|Rate limit bypassable via headers/params|X-Forwarded-For|X-Real-IP.*rate|*.{js,ts,py}
ENUM-TIMING|warning|INFO-LEAK|User enumeration via timing difference|user.*not.*found.*return|invalid.*password.*return|*.{js,ts,py,rb,php}
PRICE-MANIPULATION|critical|FINANCIAL|Client-side price sent to server|price.*req\.body|amount.*req\.body|cost.*req\.body|*.{js,ts,py}
#
# ═══ SUPPLY CHAIN ═══
TYPOSQUAT-IMPORT|warning|RCE|Suspicious package name (potential typosquat)|require\(["'](?!@)[a-z]+-[a-z]+["']\)|*.{js,ts}
POSTINSTALL-EXEC|critical|RCE|Package postinstall running code|postinstall.*node.*\||preinstall.*curl|*.json
DEPENDENCY-CONFUSION|error|RCE|Internal package name without scope|require\(["'][a-z].*-internal|*.{js,ts,py}
#
# ═══ CHAIN MULTIPLIERS ═══
# These alone are low severity but MULTIPLY impact when combined:
INFO-DISCLOSURE|warning|*|Version/stack disclosure in errors|stack.*trace|x-powered-by|server.*version|*.{js,ts,py,rb,php}
VERBOSE-ERROR|warning|*|Detailed error messages to client|res\.(send|json).*err\.(message|stack)|*.{js,ts}
DEBUG-ENABLED|warning|*|Debug mode in production|DEBUG.*true|debug.*=.*1|NODE_ENV.*development|*.{js,ts,py,rb}
ADMIN-PANEL-EXPOSED|warning|AUTH-BYPASS|Admin panel without IP restriction|/admin.*router|admin.*endpoint|*.{js,ts,py}
INTERNAL-API-EXPOSED|warning|DATA-LEAK|Internal API accessible externally|/internal/|/api/v1/debug|/api/private|*.{js,ts,py}
